pragma solidity ^0.8.0;
contract SimpleMath {
// Initialization of num1 and num2
int8 num1 = 10;
int8 num2 = 5;
int16 num3 = 90;
int16 num4 = 60;
uint32 num5 = 1000;
uint32 num6 = 500;
uint8 num7 = 100;
uint8 num8 = 200;
bool status = true;
bool status1 = false;
string message ="Hello";
string messages ='Hello';
